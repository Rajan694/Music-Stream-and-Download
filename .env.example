# ---------- shared ----------
NODE_ENV=development

# ---------- frontend ----------
VITE_API_URL=http://localhost:4000/api/v1

# ---------- backend ----------
API_PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5436/music?schema=public
# Minimum 32 characters. Generate with: openssl rand -base64 48
# Required in production; development falls back to a random per-boot value.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=localhost
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000
# Comma separated production browser origins. Development also allows loopback origins.
CORS_ORIGINS=http://localhost:3000
# Public instances go down often, and the whole published list is frequently
# dead at once. Re-probe before blaming the code:
#   curl -s -o /dev/null -w '%{http_code}\n' <instance>/streams/dQw4w9WgXcQ
# The current list lives at https://github.com/TeamPiped/documentation
# (content/docs/public-instances). Anything that is not 200 with a JSON body
# carrying `relatedStreams` is not usable — some dead hosts answer 200 with a
# plain-text notice, which only fails later at the JSON parse.
PIPED_API_URL=https://api.piped.private.coffee
# Comma separated. Public instances go down often — list several.
PIPED_FALLBACK_URLS=https://pipedapi.kavin.rocks,https://pipedapi.leptons.xyz
# Backs both the metadata cache and the BullMQ download queue. The backend
# enqueues here and the worker consumes from here, so the two MUST agree.
# `docker compose up redis` publishes one on 6380 (offset so it does not
# collide with a Redis already running on the default port).
REDIS_URL=redis://127.0.0.1:6380
MEDIA_TEMP_DIR=/tmp/music-media
MAX_DOWNLOAD_SIZE=52428800
MAX_DOWNLOAD_DURATION=1800
# Ceiling on tracks accepted from one playlist. A playlist is unbounded input,
# and each track costs a yt-dlp resolve plus an FFmpeg transcode.
MAX_PLAYLIST_ITEMS=50
JOB_TIMEOUT_MS=600000
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_MS=5000

# Provider behaviour
PROVIDER_TIMEOUT_MS=8000
PROVIDER_RETRIES=2
PROVIDER_DEADLINE_MS=20000
YT_DLP_TIMEOUT_MS=30000

# Metadata cache TTLs (applies to whichever backend REDIS_URL selects)
CACHE_SEARCH_TTL_MS=300000
CACHE_VIDEO_TTL_MS=3600000
CACHE_PLAYLIST_TTL_MS=3600000
CACHE_MAX_ENTRIES=1000

# ---------- worker ----------
# DATABASE_URL, REDIS_URL, MEDIA_TEMP_DIR and PIPED_API_URL are shared with the
# backend above — the worker reads the same .env, so do not redeclare them here.
FFMPEG_PATH=/usr/bin/ffmpeg
# Leave blank to use the yt-dlp binary vendored by youtube-dl-exec.
# Set an absolute path to prefer a system install (recommended in production,
# where the binary must be updated often to keep extraction working).
YT_DLP_PATH=
# How many jobs run in parallel. Tracks inside one playlist stay sequential.
WORKER_CONCURRENCY=2
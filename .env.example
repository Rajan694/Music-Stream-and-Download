# ---------- shared ----------
NODE_ENV=development

# ---------- frontend ----------
VITE_API_URL=http://localhost:4000/api/v1

# ---------- backend ----------
API_PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5436/music?schema=public
# Minimum 32 characters. Generate with: openssl rand -base64 48
# Required in production; development falls back to a random per-boot value.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=localhost
# Marks the refresh-token cookie Secure (HTTPS-only). Defaults to true when
# NODE_ENV=production, which breaks logins if you serve over plain HTTP (e.g.
# the default compose.yaml nginx setup on port 80) — the browser silently
# drops the cookie. Set explicitly to override the NODE_ENV-based default.
COOKIE_SECURE=
FRONTEND_URL=http://localhost:3000
# Comma separated production browser origins. Development also allows loopback origins.
CORS_ORIGINS=http://localhost:3000
# Self-hosted Piped instance. Run via `npm run infra:up` or `npm run dev`.
# Readiness probe: curl -s http://localhost:7081/config
PIPED_API_URL=http://localhost:7081
# Comma separated. Left empty because self-hosted Piped is used directly.
PIPED_FALLBACK_URLS=
# Backs both the metadata cache and the BullMQ download queue. The backend
# enqueues here and the worker consumes from here, so the two MUST agree.
# `docker compose up redis` publishes one on 6380 (offset so it does not
# collide with a Redis already running on the default port).
REDIS_URL=redis://127.0.0.1:6380
MEDIA_TEMP_DIR=/tmp/music-media
MAX_DOWNLOAD_SIZE=52428800
MAX_DOWNLOAD_DURATION=1800
# Ceiling on tracks accepted from one playlist. A playlist is unbounded input,
# and each track costs a yt-dlp resolve plus an FFmpeg transcode.
MAX_PLAYLIST_ITEMS=50
JOB_TIMEOUT_MS=600000
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_MS=5000

# Provider behaviour
PROVIDER_TIMEOUT_MS=8000
PROVIDER_RETRIES=2
PROVIDER_DEADLINE_MS=20000
YT_DLP_TIMEOUT_MS=30000

# Metadata cache TTLs (applies to whichever backend REDIS_URL selects)
CACHE_SEARCH_TTL_MS=300000
CACHE_VIDEO_TTL_MS=3600000
CACHE_PLAYLIST_TTL_MS=3600000
# How long a resolved audio URL is reused. Resolving costs a ~3.5s yt-dlp spawn;
# a cache hit serves in ~20ms, so this is the single biggest lever on playback
# latency. googlevideo URLs carry `expire` roughly 6h out — 4h leaves a margin,
# and a stale URL is evicted on the first bad upstream response regardless.
CACHE_STREAM_TTL_MS=14400000
CACHE_MAX_ENTRIES=1000

# ---------- worker ----------
# DATABASE_URL, REDIS_URL, MEDIA_TEMP_DIR and PIPED_API_URL are shared with the
# backend above — the worker reads the same .env, so do not redeclare them here.
FFMPEG_PATH=/usr/bin/ffmpeg
# youtube-dl-exec's binary download is disabled (see allowScripts in the root
# package.json), so yt-dlp always comes from the system. Leave blank to look it
# up on PATH, or set an absolute path. The images install it via apk and set
# this to /usr/bin/yt-dlp.
YT_DLP_PATH=
# How many jobs run in parallel. Tracks inside one playlist stay sequential.
WORKER_CONCURRENCY=2
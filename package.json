{
  "name": "music-stream",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@11.14.1",
  "scripts": {
    "dev": "./scripts/run.sh dev",
    "build": "./scripts/run.sh build",
    "lint": "./scripts/run.sh lint",
    "db:generate": "npm run db:generate -w packages/db",
    "db:migrate": "npm run db:migrate -w packages/db",
    "db:studio": "npm run db:studio -w packages/db"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "~6.0.2",
    "eslint": "9.39.5",
    "typescript-eslint": "8.69.0",
    "@eslint/js": "9.39.5",
    "eslint-config-next": "16.3.4",
    "@music/config": "*"
  }
}
